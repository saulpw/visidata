# a table saves to a new duckdb file and loads back

open-file tests/data3.tsv
save-sheet $VD_TESTTMP/duckdb-save-sheet.duckdb
open-file $VD_TESTTMP/duckdb-save-sheet.duckdb
exec-sql DROP TABLE data3; CREATE TABLE edit_pk (id INTEGER PRIMARY KEY, note VARCHAR, amount DECIMAL(10,2)); INSERT INTO edit_pk VALUES (1, 'naïve café', 1.25), (2, '東京', 2.50)
quit-sheet
reload-sheet
row キedit_pk
open-row
save-sheet $VD_TESTTMP/duckdb-save-sheet-out.duckdb
open-file $VD_TESTTMP/duckdb-save-sheet-out.duckdb
row キedit_pk
open-row

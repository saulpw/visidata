# #2570  reloading the source also reloads its graph
exec-python open(Path('$VD_TESTTMP/issue2570-cascade.tsv').given, 'w').write('x\ty\n1\t2\n2\t3\n')
open-file $VD_TESTTMP/issue2570-cascade.tsv
col x
type-int
key-col
col y
type-int
plot-column
assert-expr len(sheet.polylines) == 2

exec-python open(Path('$VD_TESTTMP/issue2570-cascade.tsv').given, 'a').write('3\t5\n')
jump-prev
reload-rows
jump-prev
assert-expr len(sheet.polylines) == 3

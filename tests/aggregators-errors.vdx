open-file sample_data/petshop/orders-flat.jsonl
row numeric_binning
set-option True
sheet orders-flat
col ordered
type-date
col qty
type-int
col unit_price
type-float
col qty
aggregate-col sum
col ordered
key-col
columns-sheet
sheet orders-flat_columns
row キqty
select-row
row キunit_price
select-row
aggregate-cols min
aggregate-cols max
quit-sheet
sheet orders-flat
col sku
addcol-expr sku[:3]
col sku[:3]
rename-col prefix
col prefix
pivot
sheet orders-flat_pivot_prefix
columns-sheet
sheet orders-flat_pivot_prefix_columns
col name
sort-asc
quit-sheet
sheet orders-flat_pivot_prefix
col ordered
sort-asc

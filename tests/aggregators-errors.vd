sheet	col	row	longname	input	keystrokes	comment
			open-file	sample_data/petshop/orders-flat.jsonl	o
		numeric_binning	set-option	True
orders-flat	ordered		type-date		@
orders-flat	qty		type-int		#
orders-flat	unit_price		type-float		%
orders-flat	qty		aggregate-col	sum	+
orders-flat	ordered		key-col		!
orders-flat			columns-sheet		C
orders-flat_columns		キqty	select-row		s
orders-flat_columns		キunit_price	select-row		s
orders-flat_columns			aggregate-cols	min	g+
orders-flat_columns			aggregate-cols	max	g+
orders-flat_columns			quit-sheet		q
orders-flat	sku		addcol-expr	sku[:3]	=
orders-flat	sku[:3]		rename-col	prefix	^
orders-flat	prefix		pivot		W
orders-flat_pivot_prefix			columns-sheet		C
orders-flat_pivot_prefix_columns	name		sort-asc		[
orders-flat_pivot_prefix_columns			quit-sheet		q
orders-flat_pivot_prefix	ordered		sort-asc		[

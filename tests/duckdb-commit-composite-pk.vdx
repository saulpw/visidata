# commits to a table in another schema with a composite primary key and quoted names

option global confirm y
open-file tests/data3.tsv
save-sheet $VD_TESTTMP/duckdb-commit-composite-pk.duckdb
open-file $VD_TESTTMP/duckdb-commit-composite-pk.duckdb
exec-sql DROP TABLE data3; CREATE SCHEMA other; CREATE TABLE other."edit composite" ("key one" INTEGER, "key""two" VARCHAR, note VARCHAR, PRIMARY KEY ("key one", "key""two")); INSERT INTO other."edit composite" VALUES (1, 'a', 'alpha'), (1, 'b', 'bravo'), (2, 'c', 'charlie')
quit-sheet
reload-sheet
row キedit composite
open-row
row 1
col note
edit-cell bravo+
row 2
delete-row
add-row
col key one
edit-cell 3
col key"two
edit-cell c
col note
edit-cell delta
commit-sheet
reload-sheet
